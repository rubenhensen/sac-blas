// bool eq (int[d1:shp1] a, int[d2:shp2] b) {
//     return all(a == b) && all(shp1==shp2) && all(d1==d2);
// }

// inline
bool eq (float[d1:shp1] a, float[d2:shp2] b) {
    return all(a == b) && all(shp1==shp2) && all(d1==d2);
}

bool eq (double[d1:shp1] a, double[d2:shp2] b) {
    return all(a == b) && all(shp1==shp2) && all(d1==d2);
}

// inline
bool almost_eq (float[d1:shp1] a, float[d2:shp2] b, float loss) {
    return all(abs(a - b) < loss) && all(shp1==shp2) && all(d1==d2);
}

// inline
bool almost_eq (double[d1:shp1] a, double[d2:shp2] b, double loss) {
    return all(abs(a - b) < loss) && all(shp1==shp2) && all(d1==d2);
}

// inline
bool ismember(char c, char[n] ca)
{
  b = false;
  for(i=0; i<n;i++) {
    if (ca[i] == c) b = true;
  }
  return b;
}

// inline
bool ismember(float c, float[n] ca)
{
  b = false;
  for(i=0; i<n;i++) {
    if (ca[i] == c) b = true;
  }
  return b;
}

// inline
bool ismember(int c, int[n] ca)
{
  b = false;
  for(i=0; i<n;i++) {
    if (ca[i] == c) b = true;
  }
  return b;
}

// inline
bool ismember(double c, double[n] ca)
{
  b = false;
  for(i=0; i<n;i++) {
    if (ca[i] == c) b = true;
  }
  return b;
}

// inline
bool minArrLen(int n, int arrLength, int inc)
{
    return arrLength  > (n-1)*inc;
}

// Checks max index of elements we go through is smaller than the length of x
// inline
bool sgemvXdim(char trans, int m, int n, int incx, int xn)
{
  if (trans == 'N' || trans == 'n') {
    res = minArrLen(n, xn, incx);
  } else {
    res = minArrLen(m, xn, incx);
  }
  return res;
}

// inline
bool sgemvYdim(char trans, int m, int n, int incy, int yn)
{
  if (trans == 'N' || trans == 'n') {
    res = minArrLen(m, yn, incy);
  } else {
    res = minArrLen(n, yn, incy);
  }
  return res;
}

// inline
float[m,n] bandStorageToFull(float[m,lda] storage, int kl, int ku, int m, int n)
{
  lim = n-ku;

  return { [i] -> padVectorBack(n, drop([kl-i], storage[i]))  | [i] < [kl];
           [i] -> padVectorOffset(n, i-kl, storage[i])        | [kl] <= [i] < [lim];
           [i] -> padVectorFront(n,take([kl+1], storage[i]))  | [i] < [m] };
}

// inline
double[m,n] bandStorageToFull(double[m,lda] storage, int kl, int ku, int m, int n)
{
  lim = n-ku;

  return { [i] -> padVectorBack(n, drop([kl-i], storage[i]))  | [i] < [kl];
           [i] -> padVectorOffset(n, i-kl, storage[i])        | [kl] <= [i] < [lim];
           [i] -> padVectorFront(n,take([kl+1], storage[i]))  | [i] < [m] };
}

inline
float[m,lda] fullStorageToBand(float[m,n] storage, int kl, int ku, int m, int n)
{
  lim = n-ku;
  w = kl + ku + 1;
  return {  [i] -> padVectorFront(w, take([i+ku+1], drop([max(0,i-kl)],storage[i])))  | [i] < [kl];
            [i] -> take([w], drop([i-kl],storage[i]))                                 | [i] < [lim];
            [i] -> padVectorBack(w,take([min(w,w-(i-lim))],drop([i-kl], storage[i]))) | [i] < [m]};
}

inline
double[m,lda] fullStorageToBand(double[m,n] storage, int kl, int ku, int m, int n)
{
  lim = n-ku;
  w = kl + ku + 1;
  return {  [i] -> padVectorFront(w, take([i+ku+1], drop([max(0,i-kl)],storage[i])))  | [i] < [kl];
            [i] -> take([w], drop([i-kl],storage[i]))                                 | [i] < [lim];
            [i] -> padVectorBack(w,take([min(w,w-(i-lim))],drop([i-kl], storage[i]))) | [i] < [m]};
}

// Triangular band storage to full matrix (row-major CBLAS convention)
// Workaround for sac2c ICE (issue #1): use float[n,kp1] typed parameter
// instead of float[.,.] to avoid function composition issues during
// module specialization. Callers must pass band with exact [n, k+1] shape.
//
// Upper: band[i][j-i] = A(i,j). Row i needs i zeros front, then band elements, then trailing zeros.
float[n,n] upperTriBandToFull(float[n,kp1] band, int k, int n)
{
  return { [i] -> padVectorOffset(n, i, band[i]) | [i] < [n] };
}

double[n,n] upperTriBandToFull(double[n,kp1] band, int k, int n)
{
  return { [i] -> padVectorOffset(n, i, band[i]) | [i] < [n] };
}

// Lower: band[i][k-(i-j)] = A(i,j) for j in [max(0,i-k), i].
// Band row i has valid elements at offsets [max(0,k-i)..k], representing
// columns [max(0,i-k)..i] of the full matrix.
// Strategy: reverse the band row so diagonal comes first, then pad from front
// with i zeros (placing diagonal at column i), and the invalid trailing
// entries fall off the end via padVectorBack truncation.
float[n,n] lowerTriBandToFull(float[n,kp1] band, int k, int n)
{
  // Reverse each row: [subdiag_far,...,subdiag_1,diag] -> [diag,subdiag_1,...,subdiag_far]
  // Then padVectorBack places [diag,subdiag_1,...] starting at position i, trailing zeros fill rest
  // But we need diagonal at column i, subdiag_1 at column i-1, etc.
  // So reversed row is in WRONG order. Instead: use padVectorFront to push to END then offset.
  //
  // Alternative: build row explicitly. For row i: A(i,j) = band[i][k-(i-j)] = band[i][k-i+j]
  // Valid columns: max(0,i-k) to i. At column j: band[i][k-i+j].
  // Use padVectorOffset(n, max(0,i-k), ...) with the valid sub-array.
  // Valid sub-array = drop(max(0,k-i), band[i]) ... but that's composition.
  //
  // Simplest workaround: zero invalid entries then use padVectorOffset.
  clean = band;
  for (i = 0; i < min(k, n); i++) {
    for (j = 0; j < k-i; j++) {
      clean[i,j] = 0.0f;
    }
  }
  // Now clean[i] for i < k has leading zeros. padVectorOffset places at column max(0,i-k).
  // But the leading zeros in clean[i] will appear BEFORE the valid data in the row.
  // For i=0,k=1: clean[0]=[0,2]. padVectorOffset(3, 0, [0,2]) = [0,2,0]. Wrong.
  // We need to shift the valid part to the beginning: take only last min(k+1,i+1) elements.
  // Can't compose drop+pad. So reverse the approach:
  // padVectorBack(n, take(min(k+1,i+1), drop(max(0,k-i), clean[i]))) ... too much composition.
  //
  // Final approach: build the full row using the upper tri approach on transposed band.
  // Lower tri of A = transpose of upper tri of A^T.
  // A_lower = transpose(upperTriBandToFull(transpose_band, k, n))
  // But transpose_band requires restructuring...
  //
  // Pragmatic: just build each row element by element using a nested with-loop.
  return { [i,j] -> (j >= max(0,i-k) && j <= i) ? _sel_VxA_([k-i+j], band[i]) : 0.0f | [i,j] < [n,n] };
}

double[n,n] lowerTriBandToFull(double[n,kp1] band, int k, int n)
{
  return { [i,j] -> (j >= max(0,i-k) && j <= i) ? _sel_VxA_([k-i+j], band[i]) : 0.0d | [i,j] < [n,n] };
}

// symBandToFull inlined into ssbmv/dsbmv directly to avoid SAC type inference issues

// inline
float[m] padVectorFront(int k, float[n] arr)
{
  zeros = [k-n];
  return { iv -> 0.0f           | iv < zeros;
           iv -> arr[iv-zeros]  | zeros <= iv < [k]
         };
}

// inline
double[m] padVectorFront(int k, double[n] arr)
{
  zeros = [k-n];
  return { iv -> 0.0d           | iv < zeros;
           iv -> arr[iv-zeros]  | zeros <= iv < [k]
         };
}

// inline
float[m] padVectorBack(int k, float[n] arr) | (k >= n)
{
  return { iv -> arr[iv]  | iv < [n];
           iv -> 0.0f     | [n] <= iv < [k]       
         };
}

// inline
double[m] padVectorBack(int k, double[n] arr) | (k >= n)
{
  return { iv -> arr[iv]  | iv < [n];
           iv -> 0.0d     | [n] <= iv < [k]       
         };
}

// inline
float[m] padVectorOffset(int m, int offset, float[n] arr) | (offset >= 0)
{
  return { iv -> 0.0f             | iv < [offset];  
           iv -> arr[iv-offset]   | [offset] <= iv < [n+offset];
           iv -> 0.0f             | [offset+n] <= iv < [m]       
         };
}

// inline
double[m] padVectorOffset(int m, int offset, double[n] arr) | (offset >= 0)
{
  return { iv -> 0.0d             | iv < [offset];  
           iv -> arr[iv-offset]   | [offset] <= iv < [n+offset];
           iv -> 0.0d             | [offset+n] <= iv < [m]       
         };
}

